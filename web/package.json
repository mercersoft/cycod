{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "clean": "rm -rf dist && rm -rf public/_framework && rm -rf public/blazor",
    "build": "npm run clean && tsc -b && cd .. && ./publish_blazor.sh && cd web && vite build",
    "build:optimize": "npm run clean && tsc -b && cd .. && ./publish_blazor.sh && cd web && vite build --mode production",
    "lint": "eslint .",
    "preview": "vite preview",
    "firestore:deploy": "firebase deploy --project $FIREBASE_PROJECT_ID --only firestore --force",
    "firestore:seed": "node ./scripts/seed-firestore.mjs --file ./firestore.seed.json",
    "firestore:apply": "npm run firestore:deploy && npm run firestore:seed"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.1.0",
    "lucide-react": "^0.539.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "^13.29.2",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.0"
  }
}
