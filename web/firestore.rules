rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function getUserRole() { return request.auth.token.role; }
    function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }
    function isModerator() { return isSignedIn() && request.auth.token.moderator == true; }
    function isSuperAdmin() { return isSignedIn() && getUserRole() == 'super-admin'; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // TEMP: legacy allowlist during migration
    function isLegacyOwner() {
      return request.auth != null && (
        request.auth.token.email == 'philipp.h.schmid@gmail.com' ||
        request.auth.token.email == 'robc@thinkman.com'
      );
    }

    // auth: anyone can create with strict schema; read/update gated by roles or legacy allowlist
    match /auth/{docId} {
      allow create: if
        request.resource.data.keys().hasOnly(["createdAt", "email", "action", "env"]) &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.email is string &&
        request.resource.data.action is string &&
        request.resource.data.env is string;

      allow read: if isModerator() || isAdmin() || isLegacyOwner();

      allow update, delete: if (isAdmin() || isLegacyOwner()) &&
        request.resource.data.keys().hasOnly(["createdAt", "email", "action", "env"]) &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.email is string &&
        request.resource.data.action is string &&
        request.resource.data.env is string;
    }

    // theMovement: anyone can create with strict schema; read/update gated by roles or legacy allowlist
    match /theMovement/{docId} {
      allow create: if
        request.resource.data.keys().hasOnly(["signup", "email", "env"]) &&
        request.resource.data.signup is timestamp &&
        request.resource.data.email is string &&
        request.resource.data.env is string;

      allow read: if isModerator() || isAdmin() || isLegacyOwner();

      allow update, delete: if (isAdmin() || isLegacyOwner()) &&
        request.resource.data.keys().hasOnly(["signup", "email", "env"]) &&
        request.resource.data.signup is timestamp &&
        request.resource.data.email is string &&
        request.resource.data.env is string;
    }

    // users collection governed by RBAC
    match /users/{userId} {
      allow read: if isOwner(userId) || isModerator();
      allow write: if isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'user';
    }

    // audit logs (read-only for admins; written by functions only)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


