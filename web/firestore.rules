rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      // Allowlisted admins (must be authenticated when reading/updating)
      return request.auth != null && (
        request.auth.token.email == 'philipp.h.schmid@gmail.com' ||
        request.auth.token.email == 'robc@thinkman.com'
      );
    }

    // auth: anyone can create with strict schema; only owner can read/update/delete
    match /auth/{docId} {
      allow create: if
        request.resource.data.keys().hasOnly(["createdAt", "email", "action", "env"]) &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.email is string &&
        request.resource.data.action is string &&
        request.resource.data.env is string;

      allow read: if isOwner();

      allow update, delete: if isOwner() &&
        request.resource.data.keys().hasOnly(["createdAt", "email", "action", "env"]) &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.email is string &&
        request.resource.data.action is string &&
        request.resource.data.env is string;
    }

    // theMovement: anyone can create with strict schema; only owner can read/update/delete
    match /theMovement/{docId} {
      allow create: if
        request.resource.data.keys().hasOnly(["signup", "email", "env"]) &&
        request.resource.data.signup is timestamp &&
        request.resource.data.email is string &&
        request.resource.data.env is string;

      allow read: if isOwner();

      allow update, delete: if isOwner() &&
        request.resource.data.keys().hasOnly(["signup", "email", "env"]) &&
        request.resource.data.signup is timestamp &&
        request.resource.data.email is string &&
        request.resource.data.env is string;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


