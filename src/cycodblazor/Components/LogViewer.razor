@using Cycodblazor.Services
@implements IDisposable
@inject BlazorLogger Logger

<div class="log-viewer">
    <div class="log-viewer-header">
        <h3>Application Logs</h3>
        <div class="log-controls">
            <label>
                <input type="checkbox" @bind="AutoScroll" />
                Auto-scroll
            </label>
            <label>
                <input type="checkbox" @bind="ShowDebug" />
                Show Debug
            </label>
            <button @onclick="ClearLogs" class="btn btn-sm btn-secondary">Clear</button>
        </div>
    </div>
    <div class="log-viewer-content" @ref="logContainer">
        @if (filteredLogs.Any())
        {
            @foreach (var log in filteredLogs)
            {
                <div class="log-entry @log.CssClass">
                    <span class="log-timestamp">@log.Timestamp.ToString("HH:mm:ss.fff")</span>
                    <span class="log-level">[@log.Level]</span>
                    <span class="log-message">@log.Message</span>
                </div>
            }
        }
        else
        {
            <div class="log-empty">No log entries</div>
        }
    </div>
</div>

<style>
    .log-viewer {
        border: 1px solid #ddd;
        border-radius: 4px;
        height: 400px;
        display: flex;
        flex-direction: column;
        background-color: #1e1e1e;
        color: #d4d4d4;
        font-family: 'Consolas', 'Monaco', monospace;
        font-size: 12px;
    }

    .log-viewer-header {
        padding: 8px 12px;
        background-color: #2d2d30;
        border-bottom: 1px solid #3e3e42;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .log-viewer-header h3 {
        margin: 0;
        font-size: 14px;
        color: #cccccc;
    }

    .log-controls {
        display: flex;
        gap: 12px;
        align-items: center;
        font-size: 11px;
    }

    .log-controls label {
        display: flex;
        align-items: center;
        gap: 4px;
        color: #cccccc;
        cursor: pointer;
    }

    .log-viewer-content {
        flex: 1;
        overflow-y: auto;
        padding: 8px;
        background-color: #1e1e1e;
    }

    .log-entry {
        padding: 2px 0;
        border-bottom: 1px solid transparent;
        word-wrap: break-word;
    }

    .log-entry:hover {
        background-color: #2a2d2e;
    }

    .log-timestamp {
        color: #608b4e;
        margin-right: 8px;
    }

    .log-level {
        margin-right: 8px;
        font-weight: bold;
    }

    .log-debug .log-level { color: #808080; }
    .log-info .log-level { color: #4fc3f7; }
    .log-warning .log-level { color: #ffb74d; }
    .log-error .log-level { color: #f44336; }

    .log-message {
        color: #d4d4d4;
    }

    .log-empty {
        text-align: center;
        color: #808080;
        padding: 20px;
    }

    .btn {
        padding: 4px 8px;
        border: 1px solid #464647;
        background-color: #0e639c;
        color: white;
        cursor: pointer;
        border-radius: 2px;
        font-size: 11px;
    }

    .btn:hover {
        background-color: #1177bb;
    }

    .btn-secondary {
        background-color: #5a5a5a;
    }

    .btn-secondary:hover {
        background-color: #6a6a6a;
    }
</style>

@code {
    private ElementReference logContainer;
    private List<LogEntry> allLogs = new();
    private bool autoScroll = true;
    private bool showDebug = false;

    public bool AutoScroll
    {
        get => autoScroll;
        set
        {
            autoScroll = value;
            StateHasChanged();
        }
    }

    public bool ShowDebug
    {
        get => showDebug;
        set
        {
            showDebug = value;
            StateHasChanged();
        }
    }

    private IEnumerable<LogEntry> filteredLogs =>
        allLogs.Where(log => ShowDebug || log.Level != LogLevel.Debug);

    protected override void OnInitialized()
    {
        Logger.LogEntryAdded += OnLogEntryAdded;
        RefreshLogs();
    }

    private void OnLogEntryAdded(LogEntry logEntry)
    {
        allLogs.Add(logEntry);
        
        // Maintain maximum log entries
        if (allLogs.Count > 1000)
        {
            allLogs.RemoveAt(0);
        }

        InvokeAsync(async () =>
        {
            StateHasChanged();
            if (AutoScroll)
            {
                await ScrollToBottom();
            }
        });
    }

    private void RefreshLogs()
    {
        allLogs = Logger.GetRecentLogEntries().ToList();
        StateHasChanged();
    }

    private void ClearLogs()
    {
        Logger.ClearLogs();
        allLogs.Clear();
        StateHasChanged();
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await logContainer.FocusAsync();
            await Task.Delay(50); // Small delay to ensure rendering is complete
            // Use JavaScript to scroll to bottom
            // await JSRuntime.InvokeVoidAsync("scrollToBottom", logContainer);
        }
        catch
        {
            // Ignore scroll errors
        }
    }

    public void Dispose()
    {
        Logger.LogEntryAdded -= OnLogEntryAdded;
    }
}